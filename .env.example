# ==============================================================================
# MULTI-DISASTER EARLY WARNING SYSTEM CONFIGURATION
# ==============================================================================

# Central Receiver GPS Coordinates (Default Location when hardware relies on receiver GPS)
RECEIVER_LATITUDE=17.3918
RECEIVER_LONGITUDE=78.3194

# NASA FIRMS API Settings
# Register for a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=
FIRMS_MATCH_RADIUS_KM=25.0
FIRMS_RISK_BOOST=15.0
FIRMS_MOCK_FALLBACK=true

# Telegram Alert Configuration
# Create a bot via @BotFather on Telegram and get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_COOLDOWN_SECONDS=60.0
TELEGRAM_MIN_RISK_LEVEL=HIGH

# Web Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
